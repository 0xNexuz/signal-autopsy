# Never commit real credentials. Vercel deployments use Project Settings > Environment Variables.

BITGET_API_KEY=replace_with_your_bitget_api_key
BITGET_PASSPHRASE=replace_with_your_bitget_api_passphrase

# Choose one signing method. RSA is used for authenticated Reality depth reads.
BITGET_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_private_key\n-----END PRIVATE KEY-----"
# BITGET_SECRET_KEY=replace_with_hmac_secret

BITGET_BASE_URL=https://api.bitget.com

# Use a long random server-only value. Without it, receipts are visibly labeled DEMO.
RECEIPT_SIGNING_SECRET=replace_with_at_least_32_random_characters

# S2 hackathon Qwen adversarial examiner. Without this key, the UI is visibly labeled DEMO.
BITGET_QWEN_API_KEY=replace_with_s2_qwen_key
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
QWEN_WIRE_API=responses

# Standard Model Studio is also supported when BITGET_QWEN_API_KEY is absent.
# DASHSCOPE_API_KEY=replace_with_dashscope_key
